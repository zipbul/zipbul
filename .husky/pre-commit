#!/usr/bin/env sh
set -eu

staged_files="$(git diff --cached --name-only --diff-filter=ACMR || true)"

if [ -z "$staged_files" ]; then
	exit 0
fi

should_run_checks=0

for file in $staged_files; do
	case "$file" in
		package.json|tsconfig.json|*.ts|*.js)
			should_run_checks=1
			break
			;;
		*)
			;;
	esac
done

if [ "$should_run_checks" -eq 1 ]; then
	# Keep pre-commit fast: typecheck + unit specs only.
	# Integration / e2e / cluster / soak tests live under packages/*/test/
	# and run in CI (or manually via `bun run test:integration`).
	bun run typecheck
	bun run test:unit
fi
