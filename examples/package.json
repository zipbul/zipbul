{
  "name": "zipbul-examples",
  "private": true,
  "type": "module",
  "module": "src/main.ts",
  "scripts": {
    "build": "(cd ../packages/http-adapter && bun run build) && bun ../packages/cli/src/bin/zb.ts build",
    "dev": "(cd ../packages/http-adapter && bun run build) && bun ../packages/cli/src/bin/zb.ts dev",
    "start": "bun dist/entry.js"
  },
  "dependencies": {
    "@zipbul/baker": "catalog:",
    "@zipbul/common": "workspace:*",
    "@zipbul/core": "workspace:*",
    "@zipbul/http-adapter": "workspace:*",
    "@zipbul/logger": "workspace:*",
    "@zipbul/result": "workspace:*"
  },
  "devDependencies": {
    "@zipbul/cli": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
