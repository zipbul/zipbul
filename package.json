{
  "name": "zipbul",
  "version": "0.0.1",
  "description": "Zipbul is a web server framework for building web applications with Bun.",
  "license": "MIT",
  "author": "Junhyung Park (https://github.com/parkrevil)",
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul"
  },
  "bugs": {
    "url": "https://github.com/zipbul/zipbul/issues"
  },
  "homepage": "https://github.com/zipbul/zipbul",
  "keywords": [
    "api",
    "bun",
    "zipbul",
    "framework",
    "restful"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "bun run --filter '@zipbul/*' build",
    "test": "bun --filter '*' --if-present test",
    "test:perf": "bun test packages/http-adapter/test/perf --timeout 0",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx oxlint --type-aware",
    "knip": "knip",
    "release:publish": "for d in packages/*/package.json; do [ \"$(jq -r .private $d)\" = \"true\" ] && continue; (cd $(dirname $d) && name=$(jq -r .name package.json) && ver=$(jq -r .version package.json) && bun publish --access public && echo \"New tag: $name@$ver\"); done"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "knip": "^5.63.1",
    "lint-staged": "^16.1.6",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "oxlint-tsgolint": "^0.11.1",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "packages/*/*",
      "examples",
      "benchmark"
    ],
    "catalog": {
      "@nestjs/common": "^11.1.19",
      "@nestjs/core": "^11.1.19",
      "@nestjs/platform-express": "^11.1.19",
      "@nestjs/platform-fastify": "^11.1.19",
      "@types/bun": "^1.3.13",
      "@types/express": "^5.0.6",
      "@types/node": "^25.6.0",
      "@zipbul/baker": "^3.3.0",
      "@zipbul/gildash": "0.28.0",
      "elysia": "^1.4.28",
      "express": "^5.2.1",
      "fastify": "^5.8.5",
      "hono": "^4.12.15",
      "http-status-codes": "^2.3.0",
      "mitata": "^1.0.34",
      "reflect-metadata": "^0.2.2",
      "typescript": "5.9.3"
    }
  }
}
