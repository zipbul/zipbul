{
  "name": "@zipbul/http-adapter",
  "version": "1.1.1",
  "description": "HTTP server adapter with routing and middleware for Zipbul",
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun ../../packages/cli/src/bin/zb.ts build adapter",
    "test": "bun test",
    "coverage": "bun test --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul",
    "directory": "packages/adapters/http"
  },
  "dependencies": {
    "@zipbul/common": "workspace:*",
    "@zipbul/core": "workspace:*",
    "@zipbul/logger": "workspace:*",
    "@zipbul/result": "workspace:*",
    "@zipbul/router": "0.2.3"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@types/bun": "catalog:",
    "@types/express": "catalog:",
    "elysia": "catalog:",
    "express": "catalog:",
    "fastify": "catalog:",
    "hono": "catalog:",
    "mitata": "catalog:",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@zipbul/baker": "catalog:"
  },
  "zipbul": {
    "kind": "adapter"
  },
  "sideEffects": false,
  "author": "Junhyung Park (https://github.com/parkrevil)",
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/zipbul/zipbul/issues"
  },
  "homepage": "https://github.com/zipbul/zipbul/tree/main/packages/http-adapter#readme",
  "keywords": [
    "http",
    "server",
    "adapter",
    "router",
    "middleware",
    "fetch",
    "web-api",
    "bun",
    "typescript",
    "zipbul"
  ]
}
