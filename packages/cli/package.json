{
  "name": "@zipbul/cli",
  "version": "0.1.0",
  "description": "AOT compiler CLI with dev watch and build commands for Zipbul",
  "license": "MIT",
  "type": "module",
  "bin": {
    "zb": "dist/zb.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zipbul/zipbul.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "bun build ./src/bin/zb.ts --outdir dist --target bun --format esm --packages external --minify-syntax --minify-whitespace --banner='#!/usr/bin/env bun'"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@zipbul/common": "workspace:*",
    "@zipbul/gildash": "catalog:",
    "@zipbul/logger": "workspace:*",
    "@zipbul/result": "catalog:",
    "picocolors": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
