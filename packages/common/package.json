{
  "name": "@zipbul/common",
  "version": "0.1.0",
  "description": "Shared types, interfaces, decorators and base classes for Zipbul",
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --packages external --production && tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/parkrevil/zipbul",
    "directory": "packages/common"
  },
  "dependencies": {
    "@zipbul/baker": "^0.1.0",
    "@zipbul/result": "^0.1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.0.0"
  }
}
