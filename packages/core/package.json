{
  "name": "@zipbul/core",
  "version": "0.3.1",
  "description": "DI container, application bootstrap and module system for Zipbul",
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "bun": "./src/cluster/application-worker.ts",
      "default": "./dist/src/cluster/application-worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build index.ts src/cluster/application-worker.ts --outdir dist --target bun --format esm --packages external --minify-syntax --minify-whitespace && tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul",
    "directory": "packages/core"
  },
  "dependencies": {
    "@zipbul/baker": "catalog:",
    "@zipbul/common": "workspace:*",
    "@zipbul/logger": "workspace:*",
    "@zipbul/result": "catalog:",
    "exponential-backoff": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
