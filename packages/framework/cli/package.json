{
  "name": "@zipbul/cli",
  "version": "0.1.1",
  "description": "AOT compiler CLI with dev watch and build commands for Zipbul",
  "license": "MIT",
  "author": "Junhyung Park (https://github.com/parkrevil)",
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul",
    "directory": "packages/framework/cli"
  },
  "bugs": {
    "url": "https://github.com/zipbul/zipbul/issues"
  },
  "homepage": "https://github.com/zipbul/zipbul/tree/main/packages/framework/cli#readme",
  "keywords": [
    "zipbul",
    "cli",
    "aot",
    "compiler",
    "bun",
    "dev",
    "build",
    "watch",
    "typescript"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "bin": {
    "zb": "dist/src/bin/zb.js"
  },
  "exports": {
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json && bun -e \"const fs=require('fs');const f='dist/src/bin/zb.js';fs.writeFileSync(f,'#!/usr/bin/env bun\\n'+fs.readFileSync(f,'utf8'));fs.chmodSync(f,0o755)\"",
    "test": "bun test",
    "coverage": "bun test --coverage"
  },
  "dependencies": {
    "@zipbul/common": "workspace:*",
    "@zipbul/gildash": "catalog:",
    "@zipbul/logger": "workspace:*",
    "@zipbul/result": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
