  },
  "publishConfig": {
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/zipbul/zipbul/issues"
  },
  "homepage": "https://github.com/zipbul/zipbul/tree/main/packages/framework/logger#readme",
  "keywords": [
    "logger",
    "logging",
    "structured-logging",
    "async-storage",
    "trace",
    "bun",
    "typescript",
    "zipbul"
  ],
  "peerDependencies": {
    "@zipbul/request-context": "workspace:*"
