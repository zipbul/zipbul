{
  "name": "@zipbul/logger",
  "version": "0.2.1",
  "description": "Structured logger for Zipbul",
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "default": "./dist/src/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "test": "bun test",
    "coverage": "bun test --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul",
    "directory": "packages/framework/logger"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@zipbul/request-context": "workspace:*"
