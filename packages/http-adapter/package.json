{
  "name": "@zipbul/http-adapter",
  "version": "0.1.3",
  "description": "HTTP server adapter with routing and middleware for Zipbul",
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir dist --target bun --format esm --packages external --minify-syntax --minify-whitespace && tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul",
    "directory": "packages/http-adapter"
  },
  "dependencies": {
    "@zipbul/router": "^0.2.2",
    "@zipbul/shared": "^0.0.11",
    "http-status-codes": "^2.3"
  },
  "devDependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/platform-fastify": "^11",
    "@types/bun": "^1.3.0",
    "@types/express": "^5",
    "elysia": "^1.2",
    "express": "^5",
    "fastify": "^5",
    "hono": "^4",
    "mitata": "^0.1.13",
    "reflect-metadata": "^0.2",
    "typescript": "^5"
  },
  "peerDependencies": {
    "@zipbul/baker": "^2.1.0",
    "@zipbul/common": "workspace:*",
    "@zipbul/core": "workspace:*",
    "@zipbul/logger": "workspace:*",
    "@zipbul/result": "^1.0.0"
  }
}
