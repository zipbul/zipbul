{
  "name": "@zipbul/http-adapter",
  "version": "1.1.0",
  "description": "HTTP server adapter with routing and middleware for Zipbul",
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir dist --target bun --format esm --packages external --minify-syntax --minify-whitespace && tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul",
    "directory": "packages/http-adapter"
  },
  "dependencies": {
    "@zipbul/common": "workspace:*",
    "@zipbul/core": "workspace:*",
    "@zipbul/logger": "workspace:*",
    "@zipbul/result": "catalog:",
    "@zipbul/router": "catalog:",
    "@zipbul/shared": "catalog:",
    "http-status-codes": "catalog:"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@types/bun": "catalog:",
    "@types/express": "catalog:",
    "elysia": "catalog:",
    "express": "catalog:",
    "fastify": "catalog:",
    "hono": "catalog:",
    "mitata": "catalog:",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@zipbul/baker": "catalog:"
  }
}
