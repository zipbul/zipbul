{
  "name": "@zipbul/compression",
  "version": "0.0.1",
  "description": "Bun-native HTTP response compression middleware for standard Web APIs",
  "license": "MIT",
  "author": "Junhyung Park (https://github.com/parkrevil)",
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul",
    "directory": "packages/middlewares/compression"
  },
  "bugs": {
    "url": "https://github.com/zipbul/zipbul/issues"
  },
  "homepage": "https://github.com/zipbul/zipbul/tree/main/packages/middlewares/compression#readme",
  "keywords": [
    "compression",
    "gzip",
    "brotli",
    "zstd",
    "deflate",
    "http",
    "fetch",
    "web-api",
    "bun",
    "middleware",
    "typescript",
    "zipbul"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "bun build index.ts --outdir dist --target bun --format esm --packages external --production && tsc -p tsconfig.build.json",
    "test": "bun test",
    "coverage": "bun test --coverage"
  },
  "dependencies": {
    "@zipbul/result": "workspace:*"
  },
  "peerDependencies": {
    "@zipbul/common": "workspace:*",
    "@zipbul/http-adapter": "workspace:*"
  },
  "devDependencies": {
    "@zipbul/common": "workspace:*",
    "@zipbul/http-adapter": "workspace:*"
  },
  "sideEffects": false
}
