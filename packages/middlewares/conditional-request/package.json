  },
  "peerDependencies": {
    "@zipbul/common": "workspace:*",
    "@zipbul/http-adapter": "workspace:*"
  },
  "devDependencies": {
    "@zipbul/ashward": "^0.1.0",
    "@zipbul/cli": "workspace:*",
    "@zipbul/common": "workspace:*",
    "@zipbul/http-adapter": "workspace:*",
    "@zipbul/tck": "workspace:*"
  },
  "sideEffects": [
    "**/options.js"
  ],
  "zipbul": {
    "kind": "middleware"
