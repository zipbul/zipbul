{
  "name": "@zipbul/conditional-request",
  "version": "0.1.0",
  "description": "Conditional request middleware (ETag / If-Match / 304 / 412, RFC 9110 §13) for the zipbul framework",
  "license": "MIT",
  "author": "Junhyung Park (https://github.com/parkrevil)",
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul",
    "directory": "packages/middlewares/conditional-request"
  },
  "bugs": {
    "url": "https://github.com/zipbul/zipbul/issues"
  },
  "homepage": "https://github.com/zipbul/zipbul/tree/main/packages/middlewares/conditional-request#readme",
  "keywords": [
    "conditional-request",
    "etag",
    "if-none-match",
    "if-match",
    "304",
    "precondition",
    "http",
    "bun",
    "middleware",
    "typescript",
    "zipbul"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "zb build middleware",
