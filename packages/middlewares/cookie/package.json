{
  "name": "@zipbul/cookie",
  "version": "0.0.1",
  "description": "RFC 6265bis cookie parser, signer and jar with strict security defaults for Bun",
  "license": "MIT",
  "author": "Junhyung Park (https://github.com/parkrevil)",
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul",
    "directory": "packages/middlewares/cookie"
  },
  "bugs": {
    "url": "https://github.com/zipbul/zipbul/issues"
  },
  "homepage": "https://github.com/zipbul/zipbul/tree/main/packages/middlewares/cookie#readme",
  "keywords": [
    "cookie",
    "cookie-parser",
    "cookie-jar",
    "rfc6265",
    "signed-cookies",
    "encrypted-cookies",
    "http",
    "middleware",
    "bun",
    "typescript",
    "zipbul"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "bun build index.ts --outdir dist --target bun --format esm --packages external --production && tsc -p tsconfig.build.json",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "bench": "bun run benchmark/cookie.bench.ts"
  },
  "dependencies": {
    "@zipbul/baker": "catalog:",
    "@zipbul/result": "workspace:*"
  },
  "peerDependencies": {
    "@zipbul/common": "workspace:*",
    "@zipbul/http-adapter": "workspace:*"
  },
  "sideEffects": false,
  "devDependencies": {
    "@zipbul/common": "workspace:*",
    "@zipbul/http-adapter": "workspace:*",
    "@zipbul/tck": "workspace:*",
    "fast-check": "^4.7.0",
    "mitata": "^1.0.34"
  }
}
