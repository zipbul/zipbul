{
  "name": "@zipbul/cors",
  "version": "0.1.4",
  "description": "Framework-agnostic CORS library for standard Web APIs (Request/Response)",
  "license": "MIT",
  "author": "Junhyung Park (https://github.com/parkrevil)",
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul",
    "directory": "packages/middlewares/cors"
  },
  "bugs": {
    "url": "https://github.com/zipbul/zipbul/issues"
  },
  "homepage": "https://github.com/zipbul/zipbul/tree/main/packages/cors#readme",
  "keywords": [
    "cors",
    "cross-origin",
    "preflight",
    "http",
    "fetch",
    "web-api",
    "bun",
    "middleware",
    "typescript",
    "zipbul"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "bun build index.ts --outdir dist --target bun --format esm --packages external --production && tsc -p tsconfig.build.json",
    "test": "bun test",
    "coverage": "bun test --coverage"
  },
  "dependencies": {
    "@zipbul/result": "workspace:*"
  },
  "peerDependencies": {
    "@zipbul/common": "workspace:*",
    "@zipbul/http-adapter": "workspace:*"
  },
  "devDependencies": {
    "@zipbul/common": "workspace:*",
    "@zipbul/http-adapter": "workspace:*",
    "@zipbul/shared": "workspace:*",
    "@zipbul/tck": "workspace:*"
  },
  "sideEffects": false
}
