{
  "name": "@zipbul/shared",
  "version": "0.1.0",
  "description": "Type-safe HTTP enums and constants (methods, headers, status codes) for TypeScript",
  "license": "MIT",
  "author": "Junhyung Park (https://github.com/parkrevil)",
  "repository": {
    "type": "git",
    "url": "https://github.com/zipbul/zipbul",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/zipbul/zipbul/issues"
  },
  "homepage": "https://github.com/zipbul/zipbul/tree/main/packages/shared#readme",
  "keywords": [
    "enum",
    "constants",
    "shared",
    "http",
    "http-header",
    "http-status",
    "http-method",
    "bun",
    "typescript",
    "zipbul"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "bun build index.ts --outdir dist --target bun --format esm --production && tsc -p tsconfig.build.json",
    "test": "bun test",
    "coverage": "bun test --coverage"
  },
  "sideEffects": false
}
