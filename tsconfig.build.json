{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowJs": false,
    "emitDeclarationOnly": false,
    "declaration": true,
    "stripInternal": true,
    "noEmitOnError": true,
    "allowImportingTsExtensions": false
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/test/**",
    "**/dist/**"
  ]
}
